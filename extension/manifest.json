{
  "manifest_version": 3,
  "name": "Grab — YouTube to MP4 / MP3",
  "version": "1.0.0",
  "description": "Send the video you're watching to your own Grab server and save it as an MP4 or MP3. Right-click any YouTube link, or grab a whole page at once.",
  "permissions": ["contextMenus", "storage", "downloads", "activeTab", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://*.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
